# Server Configuration
PORT=5000
ADMIN_SECRET=super_secret_admin_token_123

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL="file:./dev.db"

# Redis Cache URL (Optional - Backend will fallback to in-memory caching if not provided)
# REDIS_URL=redis://localhost:6379

# AI Layer Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Data Source API Keys
NEWS_API_KEY=your_news_api_org_key_here
CURRENTS_API_KEY=your_currents_api_key_here

# Keep-Alive Configuration (Optional)
# Set to your deployed backend URL to enable self-pinging (e.g. https://ai-news-backend.onrender.com)
BACKEND_URL=
# Interval in milliseconds (default: 600000ms = 10 minutes)
SELF_PING_INTERVAL=600000
