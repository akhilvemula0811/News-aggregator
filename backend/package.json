{
  "name": "ai-news-backend",
  "version": "1.0.0",
  "description": "AI-Powered News Aggregator Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "node scripts/prepare-db.js && prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "node scripts/prepare-db.js && prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:push": "node scripts/prepare-db.js && prisma db push",
    "test": "ts-node src/tests/run-test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.10.2",
    "ai-news-aggregator-root": "file:..",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "google-news-url-decoder": "^1.2.2",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "prisma": "^5.10.2",
    "redis": "^4.6.13",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.20",
    "@types/node-cron": "^3.0.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
